
<%- include('../partials/header', { title: title }) %>

<section class="container page-section">

    <div class="confirmation-container text-center">

        <div class="delete-icon">
            <i class="fa-solid fa-triangle-exclamation"></i>
        </div>

        <h1 class="page-title mt-3">Delete Assignment?</h1>

        <p class="text-muted mt-3">
            Are you sure you want to delete this assignment?
            This action cannot be undone.
        </p>

        <div class="assignment-preview mt-4 mb-4">

            <h5><%= assignment.title %></h5>

            <p class="mb-1">
                <strong>Course:</strong> <%= assignment.course %>
            </p>

            <p class="mb-0">
                <strong>Status:</strong> <%= assignment.status %>
            </p>

        </div>

        <!-- Confirm deletion -->
        <form
            action="/assignments/<%= assignment._id %>?_method=DELETE"
            method="POST">

            <button type="submit" class="btn btn-danger">
                <i class="fa-solid fa-trash me-2"></i>
                Yes, Delete Assignment
            </button>

            <a href="/assignments" class="btn btn-outline-secondary ms-2">
                Cancel
            </a>

        </form>

    </div>

</section>

<%- include('../partials/footer') %>
