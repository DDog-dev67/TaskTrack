
<%- include('../partials/header', { title: title }) %>

<section class="container page-section">

    <!-- Page heading -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">

        <div>
            <h1 class="page-title">My Assignments</h1>

            <p class="text-muted">
                View and manage your university coursework.
            </p>
        </div>

        <a href="/assignments/new" class="btn btn-primary">
            <i class="fa-solid fa-plus me-2"></i>
            Add Assignment
        </a>

    </div>

    <!-- Assignment directory -->
    <div class="directory-card">

        <% if (assignments.length === 0) { %>

            <div class="empty-state text-center py-5">

                <i class="fa-solid fa-folder-open"></i>

                <h4 class="mt-3">No assignments yet</h4>

                <p class="text-muted">
                    Start organizing your coursework by adding your first assignment.
                </p>

                <a href="/assignments/new" class="btn btn-primary">
                    Create Your First Assignment
                </a>

            </div>

        <% } else { %>

            <div class="table-responsive">

                <table class="table align-middle mb-0">

                    <thead>
                        <tr>
                            <th>Assignment</th>
                            <th>Course</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        <% assignments.forEach(assignment => { %>

                            <tr>

                                <td>
                                    <strong>
                                        <%= assignment.title %>
                                    </strong>

                                    <div class="small text-muted">
                                        <%= assignment.description %>
                                    </div>
                                </td>

                                <td>
                                    <%= assignment.course %>
                                </td>

                                <td>
                                    <%= new Date(assignment.dueDate).toLocaleDateString('en-CA') %>
                                </td>

                                <td>

                                    <% if (assignment.status === 'Completed') { %>
                                        <span class="status-badge completed">
                                            Completed
                                        </span>

                                    <% } else if (assignment.status === 'In Progress') { %>
                                        <span class="status-badge in-progress">
                                            In Progress
                                        </span>

                                    <% } else { %>
                                        <span class="status-badge not-started">
                                            Not Started
                                        </span>
                                    <% } %>

                                </td>

                                <td>

                                    <div class="d-flex gap-2">

                                        <a
                                            href="/assignments/<%= assignment._id %>/edit"
                                            class="btn btn-sm btn-outline-primary"
                                            title="Edit assignment">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>

                                        <a
                                            href="/assignments/<%= assignment._id %>/delete"
                                            class="btn btn-sm btn-outline-danger"
                                            title="Delete assignment">

                                            <i class="fa-solid fa-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>

            </div>

        <% } %>

    </div>

</section>

<%- include('../partials/footer') %>
